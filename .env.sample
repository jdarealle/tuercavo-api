PG_DB_NAME=tuercavo_dev
PG_ADMIN_USER=tuercavo
PG_ADMIN_PASSWORD=tuercavo_dev_password

PG_PORT=55433

# sea-orm-cli carga .env con dotenvy y expande estas variables definidas arriba.
DATABASE_URL=postgresql://${PG_ADMIN_USER}:${PG_ADMIN_PASSWORD}@127.0.0.1:${PG_PORT}/${PG_DB_NAME}

MIGRATION_DIR=./db/migration # sea-orm-cli -d

HOST=127.0.0.1
PORT=3000
RUST_LOG=info
# Scalar se incluye únicamente al compilar: cargo run -p api --features scalar

# Autenticación OIDC con sesión local en PostgreSQL; sin COOKIE_KEY.
# Registrar este callback exacto como plataforma Web en Microsoft Entra ID.
ENTRA_TENANT_ID=REEMPLAZAR_CON_UUID_DEL_TENANT
ENTRA_CLIENT_ID=REEMPLAZAR_CON_UUID_DE_LA_APLICACION
ENTRA_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_DE_LA_APLICACION
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Ruta local a la que vuelve el navegador tras el login; cuando exista la SPA, usa por ejemplo /app.
POST_LOGIN_REDIRECT_PATH=/api/auth/me
# Opcional: URL de la pantalla pública de salida de la SPA. Regístrala también
# como Redirect URI de tipo Web en Entra; no debe iniciar login automáticamente.
# POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signed-out
SESSION_TTL_SECS=28800
SESSION_IDLE_TTL_SECS=1800
