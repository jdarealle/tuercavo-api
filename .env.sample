PG_DB_NAME=tuercavo_dev
PG_ADMIN_USER=tuercavo
PG_ADMIN_PASSWORD=tuercavo_dev_password

PG_PORT=55433

DATABASE_URL=postgresql://tuercavo:tuercavo_dev_password@127.0.0.1:55433/tuercavo_dev
MIGRATION_DIR=./db/migration


PORT=3000
# URL pública con TLS para las cookies Secure; TLS requiere configuración aparte.
PUBLIC_BASE_URL=https://localhost:3000
# Vacío para Scalar en el mismo origen, sin habilitar CORS adicional.
TRUSTED_BROWSER_ORIGINS=

# Microsoft Entra ID: aplicación single-tenant y callback de tipo Web.
ENTRA_TENANT_ID=REEMPLAZAR_CON_UUID_DEL_TENANT
ENTRA_CLIENT_ID=REEMPLAZAR_CON_UUID_DE_LA_APLICACION
ENTRA_CLIENT_SECRET=REEMPLAZAR_CON_SECRETO_DE_LA_APLICACION
OIDC_REDIRECT_URI=https://localhost:3000/api/auth/callback

# Clave privada de cookies; su formato se definirá al implementar autenticación.
COOKIE_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_COOKIES
SESSION_TTL_SECS=28800
RUST_LOG=info
DOCS_ENABLED=false
